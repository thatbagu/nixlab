# ============================================================
# HOMELAB TEMPLATE — FILL IN YOUR VALUES BEFORE DEPLOYING
# ============================================================
{
  # Your Linux username on all cluster nodes
  username = "youruser";

  # Timezone for all nodes (find yours with: timedatectl list-timezones)
  timezone = "UTC";

  # SSH public key for passwordless cluster access
  # Generate: ssh-keygen -t ed25519 -C "cluster" -f ~/.ssh/cluster
  clusterSshKey = "ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY your-email@example.com";

  # ============================================================
  # CLUSTER NODES
  # Each entry maps to a hosts/<hostname>/ directory containing
  # only hardware-configuration.nix (generated by nixos-generate-config).
  # ============================================================
  nodes = {
    # master = {
    #   hostname = "mymaster";  # must match hosts/<hostname>/hardware-configuration.nix
    #   master   = true;
    #   disk     = "/dev/sda";  # verify with: lsblk
    #   tags     = [ "homelab" "master" "mymaster" ];
    #   address  = "192.168.1.10"; # fixed IP (DHCP reservation): deploys and joins without mDNS
    #   # system = "aarch64-linux";  # ARM boards (Raspberry Pi 4/5, ...); default x86_64-linux
    # };
    # worker1 = {
    #   hostname = "myworker";
    #   master   = false;
    #   disk     = "/dev/sda";
    #   tags     = [ "homelab" "worker" "myworker" ];
    # };
  };

  # ============================================================
  # DOMAIN & NETWORKING
  # ============================================================

  # Your domain. With Cloudflare enabled it must be a Cloudflare-managed public
  # domain (TLS certificates + public DNS). Without Cloudflare it can be a
  # private name, e.g. "home.arpa" (avoid .local: it's used by mDNS).
  domain = "yourdomain.example.com";

  # ============================================================
  # CLOUDFLARE (optional)
  # true:  Let's Encrypt certificates via Cloudflare DNS-01, public DNS records
  #        (ExternalDNS), DDNS for vpn.<domain>, Signal proxy.
  #        Needs cloudflare_token / cloudflare_email in secrets.yaml.
  # false: no Cloudflare account needed. Certificates come from an internal
  #        homelab CA (install its certificate on your devices, see
  #        docs/services.md), no public DNS or DDNS (set
  #        wireguard_server_endpoint to a static IP or your own DDNS name),
  #        no Signal proxy (it needs a publicly trusted certificate).
  # ============================================================
  cloudflare.enable = true;

  # ============================================================
  # PLATFORM LAYERS (all on; turn off what you don't need)
  # Each one is optional. Off, nixlab leaves it out entirely; if another part
  # needs it, `nix flake check` tells you (e.g. Nextcloud needs the VPN).
  # With all of them off (and the built-in apps below), nixlab is plain k3s
  # on NixOS: see docs/configuration.md "A minimal cluster".
  # ============================================================
  gitops.enable = true;      # Argo CD deploys from git (off: k3s applies nixlab's manifests itself)
  metallb.enable = true;     # fixed LAN IPs for services (off: k3s' load balancer, on node IPs)
  ingress.enable = true;     # the gateway (Traefik): https://<app>.<domain> for apps
  certManager.enable = true; # TLS certificates (Let's Encrypt with Cloudflare, else an internal CA)
  longhorn.enable = true;    # replicated volumes across nodes (off: k3s' local-path, per node)
  pihole.enable = true;      # LAN DNS with ad blocking (off: the VPN uses upstreamDns)
  # The VPN (WireGuard) is vpn.enable, below.

  # ============================================================
  # BUILT-IN APPS (optional; the platform works without them)
  # nextcloud:   files, calendar and contacts, reachable only over the VPN,
  #              with automatic login per VPN user (wireguardUsers' nextcloudUser)
  # signalProxy:   a Signal TLS proxy at signal.<domain> (needs Cloudflare)
  # telegramProxy: a Telegram proxy on port 443 at telegram.<domain>, disguised
  #                as HTTPS (secret telegram_proxy_secret; brings the edge proxy)
  # Your own apps go in apps/ (see docs/adding-charts.md).
  # ============================================================
  nextcloud.enable = true;
  signalProxy.enable = true;
  telegramProxy.enable = false;

  # The edge proxy (optional): HAProxy at nginxIp in front of the gateway, sharing
  # port 443 by TLS server name and forwarding raw TCP ports to your apps.
  # edge = {
  #   enable = true;
  #   domains = [ "example.org" ];                        # more domains served by the gateway
  #   tcp."22" = "my-ssh-app.my-ns.svc.cluster.local:2222"; # raw TCP ports
  # };

  # More Cloudflare DDNS records, kept pointed at your public IP (optional).
  # cloudflare.ddns.records = [ { name = "example.org"; proxied = true; } ];

  # k3s tuning (optional, see docs/configuration.md#k3s):
  # k3s.leaderElection = { leaseDuration = "60s"; renewDeadline = "40s"; }; # slow master disk
  # k3s.stableNodePasswords = true;  # reinstalled workers rejoin (new clusters only)

  # Single sign-on (OIDC) at https://auth.<domain>, VPN-only. On the VPN you're
  # signed in automatically (by your VPN address), in Nextcloud and in any app
  # you register in sso.clients. Off: Nextcloud uses its older header-based
  # VPN login. See docs/sso.md.
  sso = {
    enable = false;
    clients = [ ];
  };

  # ============================================================
  # BACKUPS (optional)
  # Longhorn backs up every volume (Nextcloud files, its database, WireGuard,
  # Pi-hole) on a schedule, and a nightly pg_dump of Nextcloud's database is
  # kept on its own volume (so it is part of the backups).
  #
  # target, one of:
  #   "s3://<bucket>@<region>/<optional/path>"  AWS S3, Backblaze B2, Cloudflare
  #                                             R2, Wasabi, MinIO, ...
  #   "nfs://<host>:/<export/path>"             a NAS share (fast local restores)
  # S3 needs backup_s3_access_key_id / backup_s3_secret_access_key in
  # secrets.yaml; set s3Endpoint for anything that isn't AWS.
  #
  # offsite (NFS target only): also copy the whole backup store to S3 every
  # night, for a local + off-site setup. Uses the same S3 keys.
  # Schedules are cron expressions in UTC.
  # ============================================================
  backups = {
    enable = false;
    target = "s3://nixlab-backups@us-east-1/";
    s3Endpoint = ""; # e.g. "https://<account-id>.r2.cloudflarestorage.com" (target region: auto); see docs/backups.md
    schedule = "0 2 * * *"; # UTC; keep it outside autoUpgrade.rebootWindow (local time)
    retain = 14; # backups kept per volume
    dumpSchedule = "30 1 * * *"; # Nextcloud DB dump; keep it before `schedule`
    offsite = {
      enable = false;
      target = "s3://nixlab-backups@us-east-1/longhorn";
      s3Endpoint = "";
      schedule = "0 5 * * *";
    };
  };

  # ============================================================
  # MONITORING (optional)
  # Prometheus + Alertmanager + Grafana (kube-prometheus-stack): node, disk,
  # Kubernetes, Longhorn, backup, certificate and Argo CD alerts. Grafana at
  # https://grafana.<domain> (LAN), admin password = grafana_admin_password.
  # Needs ~1.5 GB RAM across the cluster.
  #
  # alerts: where notifications go. Turn on any number; each needs its secret
  # in secrets.yaml (see docs/monitoring.md). With none, alerts are only
  # visible in Alertmanager/Grafana.
  # ============================================================
  monitoring = {
    enable = false;
    # "light": plain Prometheus + Alertmanager, no Grafana (~0.5 GB RAM)
    # "full":  adds the Prometheus operator and Grafana dashboards (~1.5 GB RAM)
    # Both have the same alerts and notification channels.
    flavor = "light";
    retention = "15d";
    storage = "20Gi"; # Prometheus' Longhorn volume
    alerts = {
      telegram = { enable = false; chatId = 0; };       # monitoring_telegram_bot_token
      discord.enable = false;                            # monitoring_discord_webhook_url
      email = {                                          # monitoring_smtp_password
        enable = false;
        to = "you@example.com";
        from = "nixlab@example.com";
        smarthost = "smtp.example.com:587";
        username = "nixlab@example.com";
      };
      webhook.enable = false;                            # monitoring_webhook_url
      # Push to your phone with the ntfy app (docs: Monitoring & Alerts).
      ntfy.enable = false;                               # monitoring_ntfy_url
      # Pinged every minute while monitoring works, e.g. a healthchecks.io
      # check: it alerts you when the pings stop (cluster or monitoring down).
      deadMansSwitch.enable = false;                     # monitoring_deadmans_switch_url
    };
  };

  # ============================================================
  # GITOPS (Argo CD)
  # CI renders the Kubernetes manifests into `renderedBranch` of this repo;
  # Argo CD in the cluster syncs from there. Must be reachable by the cluster
  # (a public repo, or add repo credentials to Argo CD).
  # ============================================================
  gitRepository = "https://github.com/youruser/nixlab.git";
  renderedBranch = "k8s-rendered";

  # ============================================================
  # UPDATES
  # Every week CI updates nixpkgs, Helm charts and image digests, runs all
  # tests and, when they pass, merges to main (Argo CD then deploys the apps;
  # major version jumps wait for you as a pull request).
  # autoUpgrade: every night each node builds main of gitRepository and
  # switches to it, master first, the others `spacingMinutes` apart. It
  # reboots only when the kernel changed, inside rebootWindow. The repo must be
  # readable by the nodes (public, or see docs/updates.md).
  # ============================================================
  autoUpgrade = {
    enable = true;
    time = "03:30"; # the master's start time (node's local time)
    spacingMinutes = 15;
    allowReboot = true;
    rebootWindow = { lower = "03:00"; upper = "06:00"; };
  };

  # MetalLB IP pool — must be within your LAN but outside your DHCP range
  metallbPool = "192.168.1.192/26";

  # Specific IPs assigned from the MetalLB pool for each service
  piholeIp    = "192.168.1.250"; # Pi-hole DNS/web UI
  wireguardIp = "192.168.1.194"; # WireGuard VPN endpoint
  nginxIp     = "192.168.1.193"; # the gateway (Traefik): every app's HTTPS

  # Upstream DNS server (usually your router)
  upstreamDns = "192.168.1.1";

  # Your home network. The VPN's "family" group may reach all of it.
  lan.subnet = "192.168.1.0/24";

  # File shares on one node's extra disks: a ZFS pool, SMB (and optionally
  # NFS) shares per person, browsable snapshots (docs: NAS). Each user needs
  # nas_password_<name> in secrets.yaml.
  nas = {
    enable = false;
    # node = "mymaster";
    # pool = { layout = "mirror"; disks = [ "/dev/disk/by-id/..." "/dev/disk/by-id/..." ]; };
    # users = [ "alice" ];
    # shares.family.users = [ "alice" ];
  };

  # Remote access without opening a port (docs: Remote Access): the masters
  # route your LAN into your tailnet. Needs tailscale_auth_key in secrets.yaml.
  tailscale.enable = false;

  # ============================================================
  # WIREGUARD VPN
  # subnet: the VPN's own addresses, a /24 that must not overlap your LAN or
  #   the networks your devices roam on. The server is .1, users get .2-.254.
  # groups: what each group may reach (besides Pi-hole DNS and home services
  #   through the VPN proxy). admin: everything; family: lan.subnet;
  #   friends/guests: nothing else. Change or add groups here, e.g.
  #     groups.friends.allowedNetworks = [ "192.168.1.50/32" ];  # one host
  # ============================================================
  vpn = {
    enable = true;
    subnet = "10.0.100.0/24";
    groups = { };
  };

  # ============================================================
  # WIREGUARD VPN USERS
  # Generate a keypair per user: wg genkey | tee private.key | wg pubkey > public.key
  # Store public keys in SOPS secrets and reference the secret name here.
  # ============================================================
  wireguardUsers = {
    # "alice" = {
    #   ip              = "10.0.100.2";          # Unique VPN IP per user, inside vpn.subnet
    #   group           = "admin";               # "admin" | "family" | "friends" | "guests"
    #   publicKeySecret = "alice_wg_public_key"; # SOPS secret name holding the WG public key
    #   allowedIPs      = "0.0.0.0/0";          # Traffic to route through VPN
    #   nextcloudUser   = "alice";               # Optional: enables Nextcloud VPN-SSO
    #   description     = "Alice — full admin access";
    #   enabled         = true;
    # };
    # "bob" = {
    #   ip              = "10.0.100.3";
    #   group           = "family";
    #   publicKeySecret = "bob_wg_public_key";
    #   allowedIPs      = "192.168.1.0/24";
    #   description     = "Bob — homelab access only";
    #   enabled         = true;
    # };
  };
}
