# The nodes' secrets: what `nix run .#init` puts in secrets.yaml (encrypted
# with sops; the age key is in .sops.yaml). The cluster's Secrets aren't
# here: they're secrets/k8s/, made by `nix run .#secrets -- sync`
# (docs/secrets.md).
#
# By hand: copy to secrets.yaml, fill in, then: sops --encrypt --in-place secrets.yaml

k3s_token: "a-long-random-string-for-k3s-cluster-auth"

# Linux user password, hashed: mkpasswd -m sha-512
user_password: "$6$..."

# The cluster SSH key, on the nodes (init uses ~/.ssh/nixlab-cluster)
private_ssh_key: |
  -----BEGIN OPENSSH PRIVATE KEY-----
  ...
  -----END OPENSSH PRIVATE KEY-----

# Only with the features that need them:
# disk_encryption_passphrase: "..."   # nodes.<name>.encrypt (docs/encryption.md)
# nas_password_<user>: "..."          # nas.users (docs/nas.md)
# ups_password: "..."                 # ups.enable (docs/power.md)
# tailscale_auth_key: "..."           # tailscale.enable (docs/remote-access.md)
# <user>_wg_private_key: "..."        # stored by nix run .#add-wg-user
